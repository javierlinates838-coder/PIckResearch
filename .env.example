# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (product ID, listing copy, pricing insights)
OPENAI_API_KEY=

# eBay Developer API — https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_RU_NAME=
EBAY_OAUTH_REDIRECT_URI=http://localhost:3000/api/ebay/callback
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_US

# PhotoRoom API — https://www.photoroom.com/api
PHOTOROOM_API_KEY=

# App URL (OAuth callbacks, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: session secret for signed cookies (32+ chars in production)
SESSION_SECRET=change-me-in-production-use-openssl-rand-hex-32
